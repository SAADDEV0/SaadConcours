{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "saad-concours",

	// Not a secret — an account identifier. Needed explicitly in CI, where
	// there is no interactive login for wrangler to infer it from.
	"account_id": "e38ffe4a64fbc0fd8f29348d0719ba71",
	"compatibility_date": "2026-09-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

	// Static output (.next/static, public/) is served straight from
	// Cloudflare's edge, free and uncounted, so only genuinely dynamic
	// requests reach the Worker. That matters here: the 8 public listing
	// pages and every [id] page are prerendered, so most traffic never
	// touches the request quota at all.
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},

	// Keeps saad-concours.saadconcours.workers.dev alive. Without this key
	// wrangler disables it by default, which is what silently took the test
	// URL down (404) on the first attempt at attaching the domain.
	"workers_dev": true,

	// Production hostname, attached as a ROUTE rather than a custom domain.
	//
	// custom_domain: true was the first attempt and Cloudflare refused it:
	// "Hostname already has externally managed DNS records. Delete them
	// first." Deleting the A record before the Worker could answer would have
	// taken www offline in the gap — an outage on a site that lives on search
	// traffic.
	//
	// A route needs no DNS change at all. The record stays exactly as it is
	// (A 76.76.21.21, proxied at Cloudflare); because it is proxied, requests
	// reach Cloudflare's edge first and this route intercepts them before
	// they are ever forwarded to Vercel. Rollback is deleting these four
	// lines and redeploying: traffic falls straight back through to the
	// origin, with DNS never having been touched.
	//
	// The apex is deliberately absent. Its redirect to www is Vercel config,
	// not application code, so routing it here would drop the redirect and
	// serve the site on both hostnames — duplicate content. That belongs in a
	// Cloudflare Redirect Rule, which runs at the edge for free; doing it in
	// middleware.js would mean widening its matcher to every path, which is
	// precisely the per-request cost this site was just optimised to remove.
	"routes": [
		{ "pattern": "www.saadconcours.space/*", "zone_name": "saadconcours.space" }
	],

	// Required by the cache layer to revalidate itself; the service name
	// must match "name" above.
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "saad-concours"
		}
	],

	// ISR cache lives in Workers KV rather than R2, deliberately: R2 demands
	// a payment method on file even for its free tier, and the whole point of
	// this move is to stay at zero cost. KV's free allowance (100k reads and
	// 1k writes a day) is far above this site's ISR usage, which ran roughly
	// 16k reads and 3k writes a MONTH on Vercel.
	//
	// The namespace has to exist before the first deploy:
	//   npx wrangler kv namespace create NEXT_INC_CACHE_KV
	// then paste the returned id below.
	"kv_namespaces": [
		{
			"binding": "NEXT_INC_CACHE_KV",
			"id": "1886be2a51204085a314198293cf13f6"
		}
	]
}
