// WORKER D'ENTRÉE « saad-concours » : celui qui reçoit www.saadconcours.space.
//
// Depuis le 2026-11-07, ce n'est plus le bundle Next.js (19 Mo, qui finissait
// en Error 1102 sur un isolate froid) mais worker/index.js : les routes de
// app/api et la garde de la console, quelques centaines de Ko. Next.js tourne
// dans un second Worker, « saad-concours-next » (wrangler.next.jsonc), qui ne
// reçoit que ce que ce Worker-ci lui transmet (404, images de partage).
// L'en-tête de worker/index.js détaille le partage.
//
// Ce Worker garde le nom, la route et donc les secrets d'avant
// (GITHUB_TOKEN, ADMIN_PASSWORD, ADMIN_SESSION_SECRET, KV_REST_API_URL,
// KV_REST_API_TOKEN) : `npx wrangler secret put …` vise toujours celui-ci.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": "worker/index.js",
	"name": "saad-concours",

	// Not a secret — an account identifier. Needed explicitly in CI, where
	// there is no interactive login for wrangler to infer it from.
	"account_id": "e38ffe4a64fbc0fd8f29348d0719ba71",
	"compatibility_date": "2026-09-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

	// Régénère la table des routes /api depuis app/api/**/route.js avant
	// chaque `wrangler dev` / `wrangler deploy`.
	"build": {
		"command": "node scripts/build-worker-routes.mjs",
		"watch_dir": ["app/api", "lib", "worker"]
	},

	// Les routes importent `next/server` : remplacé par une copie minimale,
	// pour ne pas embarquer le serveur Next.js. `@/…` est résolu par esbuild
	// via jsconfig.json.
	"alias": {
		"next/server": "./worker/next-server.js"
	},
	"define": {
		"process.env.NODE_ENV": "\"production\""
	},

	// Static output (.next/static, public/, pages prérendues) is served
	// straight from Cloudflare's edge, free and uncounted, without invoking
	// this Worker — sauf les chemins de `run_worker_first` : les pages de la
	// console sont des assets elles aussi, mais passent d'abord ici pour la
	// vérification de session. scripts/prerender-to-assets.mjs refuse de
	// publier une page /admin si ces motifs ne la couvrent plus.
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS",
		"run_worker_first": ["/admin", "/admin/*", "/admin.*"]
	},

	// Keeps saad-concours.saadconcours.workers.dev alive. Without this key
	// wrangler disables it by default, which is what silently took the test
	// URL down (404) on the first attempt at attaching the domain.
	"workers_dev": true,

	// Production hostname, attached as a ROUTE rather than a custom domain.
	//
	// custom_domain: true was the first attempt and Cloudflare refused it:
	// "Hostname already has externally managed DNS records. Delete them
	// first." Deleting the A record before the Worker could answer would have
	// taken www offline in the gap — an outage on a site that lives on search
	// traffic.
	//
	// A route needs no DNS change at all. The record stays exactly as it is
	// (A 76.76.21.21, proxied at Cloudflare); because it is proxied, requests
	// reach Cloudflare's edge first and this route intercepts them before
	// they are ever forwarded to Vercel. Rollback is deleting these four
	// lines and redeploying: traffic falls straight back through to the
	// origin, with DNS never having been touched.
	//
	// The apex is deliberately absent. Its redirect to www is Vercel config,
	// not application code, so routing it here would drop the redirect and
	// serve the site on both hostnames — duplicate content. That belongs in a
	// Cloudflare Redirect Rule, which runs at the edge for free.
	"routes": [
		{ "pattern": "www.saadconcours.space/*", "zone_name": "saadconcours.space" }
	],

	// Le Worker Next.js, pour tout ce que ni les assets ni ce Worker ne
	// servent. Il doit exister avant le premier déploiement de celui-ci : le
	// workflow le déploie en premier.
	"services": [
		{
			"binding": "NEXT",
			"service": "saad-concours-next"
		}
	]
}
