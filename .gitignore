__pycache__/
*.pyc

# Next.js / Node
node_modules/
.next/
.vercel/
npm-debug.log*
.env*.local
.vercel
.env*

# Local-only working dirs. None of these are used by the website, so they stay
# out of git entirely and therefore out of every deployment. Together they are
# ~1.1GB; since Vercel keeps every deployment forever on Hobby, a single
# `git add -A` would otherwise add that much to Deployment Storage per push.
# (video/node_modules alone holds a 209MB chrome-headless-shell that GitHub
# would reject outright, being over its 100MB per-file limit.)
# NOTE: ignored means not backed up to GitHub — keep your own copy of these.
video/
mobile/
docs/
scripts/collecte/
.claude/

# Ledger written by scripts/upload-images-to-r2.sh so re-runs skip
# objects already in R2. Local bookkeeping, not part of the site.
scripts/.r2-uploaded

# wrangler local secrets — never commit
.dev.vars

# OpenNext build output for Cloudflare
.open-next/
.wrangler/
